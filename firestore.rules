rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Funções auxiliares ----------
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Admin = existe um documento admins/{uid}. Só dá para criar pelo console do Firebase.
    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // ---------- Validação dos dados ----------
    function isValidUrbanIssue(data) {
      let baseKeys = ['id', 'type', 'title', 'description', 'location', 'reporterId', 'reporterName', 'createdAt', 'status', 'likesCount', 'likedBy'];

      return data.keys().hasAll(baseKeys)
        && data.keys().size() >= 11 && data.keys().size() <= 15
        && data.id is string && data.id.size() <= 128
        && data.type in ['pothole', 'flooding', 'power_outage', 'fire', 'light_failure', 'garbage', 'other']
        && data.title is string && data.title.size() <= 200
        && data.description is string && data.description.size() <= 2000
        && data.location.lat is number && data.location.lng is number
        && data.reporterId is string && data.reporterId.size() <= 128
        && data.reporterName is string && data.reporterName.size() <= 100
        && data.createdAt is timestamp
        && data.status in ['pending', 'in_progress', 'solved']
        && data.likesCount is number
        && data.likedBy is list
        && (!('address' in data) || data.address is string)
        && (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 1048576))
        && (!('updatedAt' in data) || data.updatedAt is timestamp)
        && (!('commentsCount' in data) || data.commentsCount is number);
    }

    function isValidComment(data) {
      return data.keys().hasAll(['id', 'issueId', 'userId', 'userName', 'text', 'createdAt', 'fromAdmin'])
        && data.keys().size() == 7
        && data.id is string && data.id.size() <= 128
        && data.issueId is string && data.issueId.size() <= 128
        && data.userId == request.auth.uid
        && data.userName is string && data.userName.size() <= 100
        && data.text is string && data.text.size() >= 1 && data.text.size() <= 1000
        && data.fromAdmin is bool
        && data.fromAdmin == isAdmin()
        && data.createdAt == request.time;
    }

    // ---------- Tipos de atualização permitidos em um relato ----------
    // Curtir ou descurtir: só o próprio UID entra ou sai de likedBy, e o contador muda em 1
    function isLikeChange() {
      let before = resource.data.likedBy;
      let after = request.resource.data.likedBy;
      let uid = request.auth.uid;
      return changedKeys().hasOnly(['likesCount', 'likedBy'])
        && after is list
        && (
          (!(uid in before) && after.hasAll(before) && uid in after
            && after.size() == before.size() + 1
            && request.resource.data.likesCount == resource.data.likesCount + 1)
          ||
          ((uid in before) && before.hasAll(after) && !(uid in after)
            && after.size() == before.size() - 1
            && request.resource.data.likesCount == resource.data.likesCount - 1)
        );
    }

    // Novo comentário: o contador só pode subir de 1 em 1
    function isCommentCountChange() {
      let before = ('commentsCount' in resource.data) ? resource.data.commentsCount : 0;
      return changedKeys().hasOnly(['commentsCount'])
        && request.resource.data.commentsCount == before + 1;
    }

    // Mudança de status: somente administradores
    function isStatusChange() {
      return isAdmin()
        && changedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.status in ['pending', 'in_progress', 'solved']
        && request.resource.data.updatedAt == request.time;
    }

    // ---------- Coleções ----------
    match /issues/{issueId} {
      allow read: if true;

      allow create: if isSignedIn()
        && isValidId(issueId)
        && isValidUrbanIssue(request.resource.data)
        && request.resource.data.id == issueId
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.status == 'pending'
        && request.resource.data.likesCount == 0
        && request.resource.data.likedBy.size() == 0;

      allow update: if isSignedIn()
        && (isLikeChange() || isCommentCountChange() || isStatusChange());

      allow delete: if isAdmin();

      match /comments/{commentId} {
        allow read: if true;

        allow create: if isSignedIn()
          && isValidId(commentId)
          && isValidComment(request.resource.data)
          && request.resource.data.id == commentId
          && request.resource.data.issueId == issueId;

        allow delete: if isSignedIn()
          && (isOwner(resource.data.userId) || isAdmin());
      }
    }

    // Cada pessoa só consegue ler o próprio documento. Ninguém escreve pelo site.
    match /admins/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }
  }
}